# Local diff for the Rockchip BSP kernel (develop-6.12).
#
# Baseline is the tree's own arch/arm64/configs/rockchip_linux_defconfig, then the tree's own
# arch/arm64/configs/rk3588.config (that four-line file is how Rockchip composes an RK3588
# config: it turns on CONFIG_MALI_VALHALL for the G610), then this file, then olddefconfig.
# The defconfigs are never edited; every local difference lives here.
#
# Every symbol name below was read out of this tree's Kconfig files (drivers/rknpu/Kconfig,
# drivers/gpu/arm/valhall/Kconfig, drivers/media/platform/verisilicon/Kconfig), not remembered.
# olddefconfig silently drops a symbol kconfig has never heard of, so the ones that matter are
# asserted in check() instead of trusted from this file.

# ---------------------------------------------------------------------------
# No initramfs: everything needed to reach and mount root must be built in.
# Several of these are simply absent from the vendor defconfig (kconfig default is n) because
# the vendor image ships an initramfs; the board does not, so at mount time a driver left at
# =m means the root device does not exist yet.
# ---------------------------------------------------------------------------
CONFIG_BTRFS_FS=y
CONFIG_CRYPTO_ZSTD=y
CONFIG_MMC_BLOCK=y
CONFIG_MMC_SDHCI_OF_DWCMSHC=y
CONFIG_NVME_CORE=y
CONFIG_BLK_DEV_NVME=y
CONFIG_PCIE_DW_HOST=y
CONFIG_PHY_ROCKCHIP_SNPS_PCIE3=y
CONFIG_PHY_ROCKCHIP_NANENG_COMBO_PHY=y
CONFIG_PHY_ROCKCHIP_TYPEC=y
CONFIG_PHY_ROCKCHIP_INNO_USB2=y
CONFIG_PHY_ROCKCHIP_USB=y
CONFIG_USB_XHCI_PLATFORM=y
CONFIG_USB_DWC3_OF_SIMPLE=y
CONFIG_USB_EHCI_HCD_PLATFORM=y
CONFIG_USB_OHCI_HCD_PLATFORM=y
CONFIG_USB_UAS=y
CONFIG_USB_HID=y
CONFIG_HID_GENERIC=y

# Runtime peripherals verified on the V1 board: GT911 and USB CDC Ethernet.
CONFIG_INPUT_TOUCHSCREEN=y
CONFIG_TOUCHSCREEN_GOODIX=m
CONFIG_USB_USBNET=m
CONFIG_USB_NET_CDCETHER=m
CONFIG_USB_NET_CDC_NCM=m

# ---------------------------------------------------------------------------
# The reason this kernel exists next to the mainline one: the vendor accelerators that
# Rockchip's closed userspace (libmali, librknnrt, libmpp) talks to. Not boot critical, so
# modules where kconfig offers it - they are loaded by udev/modprobe from /usr/lib/modules.
# ---------------------------------------------------------------------------
CONFIG_MALI_VALHALL=y
CONFIG_MALI_VALHALL_PLATFORM_NAME="rk"
CONFIG_MALI_VALHALL_CSF_SUPPORT=y
# =y, not =m, and that is a build constraint rather than a preference: modpost fails on
#   ERROR: modpost: "iommu_get_dma_cookie" [drivers/rknpu/rknpu.ko] undefined!
# because drivers/iommu/dma-iommu.c defines iommu_get_dma_cookie() without EXPORT_SYMBOL (it
# has exactly two exports in the file), so the symbol is only reachable from vmlinux. Every
# other vendor driver in this config is =y for the same reason (MALI_VALHALL, DRM_ROCKCHIP,
# VIDEO_ROCKCHIP_RGA, VIDEO_HANTRO_ROCKCHIP). drivers/rknpu is the only place in the tree
# outside the iommu core that calls it, so this fixes the whole class, not one instance.
CONFIG_ROCKCHIP_RKNPU=y
CONFIG_ROCKCHIP_RKNPU_PROC_FS=y
CONFIG_ROCKCHIP_RKNPU_FENCE=y
CONFIG_VIDEO_HANTRO=y
CONFIG_VIDEO_HANTRO_ROCKCHIP=m

# ---------------------------------------------------------------------------
# Debug information. The vendor defconfig builds DWARF for everything
# (CONFIG_DEBUG_INFO_DWARF_TOOLCHAIN_DEFAULT=y plus DEBUG_INFO_REDUCED=y). This package has no
# -debug sibling, and the result lands on a 3 GiB root partition, so the debug sections go.
# It also keeps the build from needing pahole (dwarves) if DEBUG_INFO_BTF ever appears in the
# baseline, and shortens the build measurably.
# ---------------------------------------------------------------------------
# CONFIG_DEBUG_INFO is not set

# ---------------------------------------------------------------------------
# System capabilities the userspace needs.
#
# rockchip_linux_defconfig targets Android/embedded, where nothing sets these. This board runs
# Arch Linux, and without SECURITY there is no Landlock, which makes pacman refuse every
# transaction ("restricting filesystem access failed because Landlock is not supported by the
# kernel"). An earlier version of this file left Landlock out on purpose to avoid pulling the
# LSM framework into a vendor kernel; that was the wrong trade - a package manager that cannot
# run outranks keeping the vendor config untouched. The rest of the list is the same argument:
# each one is something ordinary userspace asks for, and the mainline package already has them.
# Values follow CONFIG_LSM in the mainline config; SELinux and AppArmor stay off, as there.
# ---------------------------------------------------------------------------
CONFIG_SECURITY=y
CONFIG_SECURITY_LANDLOCK=y
CONFIG_SECURITY_YAMA=y
CONFIG_LSM="yama,loadpin,safesetid,integrity,landlock"
CONFIG_MEMCG=y
CONFIG_PSI=y
CONFIG_PSI_DEFAULT_DISABLED=n
CONFIG_BPF_SYSCALL=y
CONFIG_BPF_JIT=y
CONFIG_CGROUP_BPF=y
CONFIG_WATCH_QUEUE=y
CONFIG_FANOTIFY=y
CONFIG_KALLSYMS_ALL=y
CONFIG_PROC_KCORE=y

# device mapper, LUKS and container image layers. =y to match mainline: DM_CRYPT sits on top of
# it and a module here would change when the crypto targets become available.
CONFIG_BLK_DEV_DM=y
CONFIG_ENCRYPTED_KEYS=y
CONFIG_TRUSTED_KEYS=m
CONFIG_DM_CRYPT=m
CONFIG_OVERLAY_FS=m

# Compressed swap in RAM. =y so it exists before any module can be loaded, and it needs no
# block device.
CONFIG_ZSWAP=y

# Networking userspace expects: traffic shaping, nftables, tunnels, bridges, VPN.
CONFIG_NET_SCHED=y
# NET_ACT_BPF depends on NET_CLS_ACT, so the action framework has to be on as well; without it
# olddefconfig silently drops the symbol and only CONFIG_NET_CLS_BPF survives.
CONFIG_NET_CLS_ACT=y
CONFIG_NET_CLS_BPF=m
CONFIG_NET_ACT_BPF=m
CONFIG_TUN=m
CONFIG_VETH=m
CONFIG_BRIDGE=m
CONFIG_MACVLAN=m
CONFIG_VLAN_8021Q=m
CONFIG_NF_TABLES=m
CONFIG_WIREGUARD=m

# Suspend to disk is available on mainline; keeping the vendor's "no" would be a silent
# difference between the two kernels for no reason. Untested on this board.
CONFIG_HIBERNATION=y

# ---------------------------------------------------------------------------
# Framebuffer console.
#
# Androide does not need fbcon, so rockchip_linux_defconfig leaves FB off entirely
# ("# CONFIG_FB is not set") and the DRM driver therefore has no fbdev emulation. Without this
# the DSI panel works - modetest can set a mode and the image appears - but the kernel console
# never reaches it and nothing lights the panel at boot.
#
# FB is the menuconfig that pulls in FB_CORE; FRAMEBUFFER_CONSOLE needs FB_CORE, and
# DRM_FBDEV_EMULATION provides the console on top of the DRM driver. Values follow mainline.
# ---------------------------------------------------------------------------
CONFIG_FB=y
CONFIG_FB_CORE=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_FRAMEBUFFER_CONSOLE_DETECT_PRIMARY=y
CONFIG_FRAMEBUFFER_CONSOLE_ROTATION=y
