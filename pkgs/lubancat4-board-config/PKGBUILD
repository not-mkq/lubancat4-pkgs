# Maintainer: mkq <mkq@mail.ustc.edu.cn>
# Board tooling for the EmbedFire LubanCat-4 on mainline. This package holds only files a
# package may legitimately own: programs, unit overrides, templates. Everything that is
# per-image identity (hostname, locale, mirror list) and every service enable lives in
# scripts/03-mkimg.sh instead - see the notes at the bottom of package().
pkgname=lubancat4-board-config
pkgver=1
pkgrel=7
pkgdesc='Board tooling for EmbedFire LubanCat-4 (RK3588S2) running Arch Linux ARM'
arch=('any')
url='https://github.com/wasmkq/lubancat4-arch'
license=('GPL-2.0-only')
depends=('openssh' 'systemd' 'util-linux')
makedepends=()
source=('50-lubancat.network' 'extlinux.conf.in' 'extlinux-bsp.conf.in'
        'fstab.in' 'lubancat4-flash-boot' 'lubancat4-overlay' 'lubancat4-status'
        'lubancat4-set-default' 'lubancat4-set-default.fish' 'overlays.conf' 'overlays-bsp.conf')
sha256sums=(  'ef3d31ec6bc0dd2cecfd04c2dc8a942d033550fb1a3d7e6b26543dfeb11149ba'
  '367aa5e014809aecc79d73e4f8a6b1ab92e54069725adcc53b2bc85804d8a5dc'
  '34ccd25eb17475e7416dd65c01e6eb52244169394445d98e7dcde1a5580aec33'
  '2b9ae86e82927762d62cdab3db7dec1c0b1875451b542613ec74e496e71eeeb9'
  'a7bc861ba3f8dd1a862556897ae4b69b4c8039f0c9baf161c6e1ebd2103d3500'
  'f56b6bab9ed4cb265b2a0dedcb17102e19ca052ef4b82065003c828c2c736699'
  'f2b4573adb33583220e7e39fa08101dc9955f26c2c9288e08ded9ef7799b4992'
  'c3fe200afff948f2b4d5f34b79b37a1aa4f430d0553da8237ad5b2b9dc4f775f'
