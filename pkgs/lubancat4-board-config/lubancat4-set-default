#!/bin/sh
# Set the U-Boot extlinux entry explicitly. Kernel package installation does not change it.
set -eu

CONF=/boot/extlinux/extlinux.conf
case ${1-} in
  -h|--help)
    echo "usage: lubancat4-set-default arch|bsp"
    exit 0
    ;;
  arch|bsp) label=$1 ;;
  *)
    echo "usage: lubancat4-set-default arch|bsp" >&2
    exit 2
    ;;
esac

[ -f "$CONF" ] || { echo "lubancat4: $CONF does not exist" >&2; exit 1; }
grep -qE "^[[:space:]]*label[[:space:]]+$label([[:space:]]|$)" "$CONF" || {
  echo "lubancat4: extlinux entry '$label' is not present" >&2
  exit 1
}

tmp=$(mktemp "$CONF.XXXXXX")
trap 'rm -f "$tmp"' EXIT HUP INT TERM
awk -v want="$label" '
  /^[[:space:]]*default[[:space:]]/ { if (!done) { print "default " want; done=1 }; next }
  { print }
  END { if (!done) print "default " want }
' "$CONF" > "$tmp"
chmod --reference="$CONF" "$tmp" 2>/dev/null || chmod 644 "$tmp"
mv -f "$tmp" "$CONF"
echo "lubancat4: default boot entry set to '$label'"
