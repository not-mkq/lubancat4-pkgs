#!/bin/sh
# Make the kernel entry this package owns the default one in /boot/extlinux/extlinux.conf.
#
# The image script writes both entries when both kernels are installed; this hook lets a
# later `pacman -S`/`-R` on the board move the default without editing the file by hand.
#   linux-lubancat4-git  -> label arch
#   linux-lubancat4-bsp  -> label bsp
#
# Only the global "default" line is touched. Every other line, including the other kernel's
# entry and its fdtoverlays line, is copied through unchanged. The label must already exist:
# a hook that points "default" at a missing entry is worse than doing nothing.
set -eu

KERNEL_LABEL=@LABEL@
CONF=/boot/extlinux/extlinux.conf

# boot is a separate filesystem; a hook can run before it is mounted.
[ -f "$CONF" ] || exit 0

# Never leave a half-written boot config behind, even if this script is interrupted.
tmp=$(mktemp "$CONF.XXXXXX") || exit 0
trap 'rm -f "$tmp"' EXIT HUP INT TERM

if ! grep -qE "^[[:space:]]*label[[:space:]]+$KERNEL_LABEL([[:space:]]|$)" "$CONF"; then
    echo "lubancat4: $CONF has no '$KERNEL_LABEL' entry, default kernel unchanged" >&2
    exit 0
fi

awk -v want="$KERNEL_LABEL" '
    /^[[:space:]]*default[[:space:]]/ { if (!done) { print "default " want; done = 1 } ; next }
    { print }
    END { if (!done) print "default " want }
' "$CONF" > "$tmp" || exit 0

# Same content, same mode; the rename is what makes the change atomic for U-Boot.
cmp -s "$tmp" "$CONF" && exit 0
chmod --reference="$CONF" "$tmp" 2>/dev/null || chmod 644 "$tmp"
mv -f "$tmp" "$CONF"
echo "lubancat4: default boot entry set to '$KERNEL_LABEL'"
