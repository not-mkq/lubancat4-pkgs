# Local kernel config fragment: Arch ARM's config plus the symbols below.
# Why each one is here: COOKBOOK.md section 8 and OVERLAYS.md.
CONFIG_CRYPTO_ZSTD=y
# VeriSilicon VPU IOMMU. Not a boot-path requirement (it gates the AV1/video-codec
# subsystem, whose nodes are disabled in the base dts); kept =y so the IOMMU setup does
# not depend on a module load order when the VPU is later enabled.
CONFIG_VSI_IOMMU=y
# The EBF410173 screen driver. =m because MIPI_DSI is =m in Arch's config and a symbol
# whose dependency is a module cannot be built-in; udev loads it from the panel node's
# modalias once rockchipdrm has registered the DSI host. Kept explicit here so a config
# change upstream cannot quietly drop the driver.
CONFIG_DRM_PANEL_EMBEDFIRE_EBF410173=m

# Storage paths that are not the default boot device but must survive a boot with no
# initramfs. Arch Linux ARM ships this one as a module because its own images use an
# initramfs; on this board the combo PHY is what powers the PCIe2 lane an NVMe adapter
# would sit on and the USB3 lane an external SSD would sit on, so a module here means the
# device never appears before root is mounted.
CONFIG_PHY_ROCKCHIP_NANENG_COMBO_PHY=y

# Drivers the .dtso overlays depend on at runtime. These are pinned so a config.base change
# upstream cannot drop or re-grade one of them and turn a green build into "no picture /
# no touch / no keys" on the board. Values are the ones Arch's config already produces;
# pinning them makes the dependency explicit rather than incidental.
CONFIG_DRM_ROCKCHIP=m
CONFIG_DRM_DW_MIPI_DSI2=m
CONFIG_PHY_ROCKCHIP_SAMSUNG_DCPHY=m
CONFIG_BACKLIGHT_PWM=y
CONFIG_TOUCHSCREEN_GOODIX=m
CONFIG_GPIO_PCA953X=y
CONFIG_KEYBOARD_GPIO=m
CONFIG_I2C_RK3X=y
CONFIG_PWM_ROCKCHIP=y
